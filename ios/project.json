{
  "name": "Lumen",
  "options": {
    "minimumXcodeGenVersion": "2.42.0",
    "deploymentTarget": { "iOS": "17.0" }
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "MARKETING_VERSION": "0.1.0",
      "CURRENT_PROJECT_VERSION": "1",
      "CODE_SIGN_STYLE": "Automatic",
      "DEVELOPMENT_TEAM": "",
      "COPILOT_APP_GROUP": "group.com.juliank103.mellodycopilot"
    }
  },
  "targets": {
    "Lumen": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "App", "Shared", "LiveActivity",
        { "path": "../core/copilot.js", "buildPhase": "resources" },
        { "path": "../core/shift.js", "buildPhase": "resources" },
        { "path": "../core/screen-reader.js", "buildPhase": "resources" },
        { "path": "../core/map-reader.js", "buildPhase": "resources" },
        { "path": "../fixtures/sample-shift.json", "buildPhase": "resources" }
      ],
      "settings": { "base": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.juliank103.mellodycopilot",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "TARGETED_DEVICE_FAMILY": "1"
      } },
      "info": {
        "path": "Generated/App-Info.plist",
        "properties": {
          "CFBundleDisplayName": "__APP_FULL__",
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
          "CopilotAppGroup": "$(COPILOT_APP_GROUP)",
          "UIBackgroundModes": ["location", "audio"],
          "NSSupportsLiveActivities": true,
          "NSPhotoLibraryAddUsageDescription": "With \"Save offer screens to Photos\" on, __APP_NAME__ saves each offer screen it reads to your photos, to train its map reader on your PC.",
          "NSLocationWhenInUseUsageDescription": "Measures your drive back after offers and adds up your miles during a shift. Your route is not stored or shared; only mile totals and the places of restaurants you arrive at.",
          "NSLocationAlwaysAndWhenInUseUsageDescription": "Lets __APP_NAME__ measure your drive back and add up shift miles while you use your delivery apps. Your route is not stored or shared; only mile totals and the places of restaurants you arrive at.",
          "ALTAppGroups": ["$(COPILOT_APP_GROUP)"],
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "CaptureExtensionIdentifier": "com.juliank103.mellodycopilot.Capture",
          "ITSAppUsesNonExemptEncryption": false,
          "LSSupportsOpeningDocumentsInPlace": false,
          "CFBundleDocumentTypes": [{ "CFBundleTypeName": "__APP_NAME__ backup", "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate", "LSItemContentTypes": ["public.json"] }]
        }
      },
      "entitlements": { "path": "Generated/App.entitlements", "properties": {
        "com.apple.security.application-groups": ["$(COPILOT_APP_GROUP)"]
      } },
      "dependencies": [{ "target": "CaptureProbe" }, { "target": "TripWidgets" }, { "sdk": "JavaScriptCore.framework" }]
    },
    "LumenTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "sources": ["Tests"],
      "dependencies": [{ "target": "Lumen" }],
      "settings": { "base": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.juliank103.mellodycopilot.tests",
        "GENERATE_INFOPLIST_FILE": "YES"
      } }
    },
    "LumenUITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": ["UITests"],
      "dependencies": [{ "target": "Lumen" }],
      "settings": { "base": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.juliank103.mellodycopilot.uitests",
        "GENERATE_INFOPLIST_FILE": "YES",
        "TEST_TARGET_NAME": "Lumen"
      } }
    },
    "TripWidgets": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": ["Widgets", "LiveActivity"],
      "settings": { "base": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.juliank103.mellodycopilot.TripWidgets",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) WIDGET_EXTENSION",
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "SKIP_INSTALL": "YES"
      } },
      "dependencies": [{ "sdk": "WidgetKit.framework" }, { "sdk": "SwiftUI.framework" }],
      "info": {
        "path": "Generated/Widgets-Info.plist",
        "properties": {
          "CFBundleDisplayName": "__APP_NAME__ Trip",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "NSExtension": { "NSExtensionPointIdentifier": "com.apple.widgetkit-extension" }
        }
      }
    },
    "CaptureProbe": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": [
        "Capture", "Shared",
        { "path": "../core/copilot.js", "buildPhase": "resources" },
        { "path": "../core/screen-reader.js", "buildPhase": "resources" },
        { "path": "../core/map-reader.js", "buildPhase": "resources" },
        { "path": "../core/lifecycle.js", "buildPhase": "resources" },
        { "path": "Models", "type": "folder", "buildPhase": "resources", "optional": true }
      ],
      "settings": { "base": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.juliank103.mellodycopilot.Capture",
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "SKIP_INSTALL": "YES"
      } },
      "dependencies": [{ "sdk": "JavaScriptCore.framework" }],
      "info": {
        "path": "Generated/Capture-Info.plist",
        "properties": {
          "CFBundleDisplayName": "__APP_NAME__ Reader",
          "CopilotAppGroup": "$(COPILOT_APP_GROUP)",
          "NSPhotoLibraryAddUsageDescription": "With \"Save offer screens to Photos\" on, __APP_NAME__ saves each offer screen it reads to your photos, to train its map reader on your PC.",
          "NSLocationWhenInUseUsageDescription": "Used only to measure your drive back to __HOME_NAME__ when an offer arrives. Your position is not stored or shared.",
          "NSLocationAlwaysAndWhenInUseUsageDescription": "Lets the screen-reading broadcast measure your drive back to __HOME_NAME__ while you use your delivery apps. Your position is not stored or shared.",
          "ALTAppGroups": ["$(COPILOT_APP_GROUP)"],
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.broadcast-services-upload",
            "NSExtensionPrincipalClass": "$(PRODUCT_MODULE_NAME).SampleHandler",
            "RPBroadcastProcessMode": "RPBroadcastProcessModeSampleBuffer"
          }
        }
      },
      "entitlements": { "path": "Generated/Capture.entitlements", "properties": {
        "com.apple.security.application-groups": ["$(COPILOT_APP_GROUP)"]
      } }
    }
  },
  "schemes": {
    "Lumen": {
      "build": { "targets": { "Lumen": "all", "CaptureProbe": "all", "TripWidgets": "all" } },
      "test": { "targets": ["LumenTests", "LumenUITests"] }
    }
  }
}
